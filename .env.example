# Copy to .env and fill in. Both values are safe to expose in client code.
# Find them in the Supabase dashboard under Project Settings > API.
#
# Use the "anon" / publishable key ONLY.
# Never put the service_role key in a VITE_ variable - Vite inlines these
# into the browser bundle, where anyone can read them.

VITE_SUPABASE_URL=https://wsrdjdvocmcqdpiogswk.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
